# ============================================================
# YUMMYGO / TAC — environment template
# Copy to `.env.local` and fill values before enabling live
# integrations. Never commit real secrets. Nothing below is a
# secret; it is a schema of available environment variables.
# ============================================================

# --- Application ---
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (LIVE) ---
# STATUS: BLOCKED_EXTERNAL_DEPENDENCY in the current workspace
# (no local/managed PostgreSQL). Prisma schema is authored and
# validated; data is served from typed static seed modules.
# DATABASE_URL="postgresql://user:password@localhost:5432/yummygo?schema=public"

# --- Cache / Jobs (LIVE) ---
# STATUS: BLOCKED_EXTERNAL_DEPENDENCY (no Redis available).
# REDIS_URL="redis://localhost:6379"

# --- AI provider (LIVE) ---
# When unset the assistant uses the deterministic local engine
# with a mock LLM adapter, and fails closed. Set to enable a real
# model behind the adapter (guardrails still enforced).
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL=""

# --- Video platform (LIVE) ---
# YouTube Data API v3 key; embedding is used when unset.
# VIDEO_API_KEY=""

# --- Grocery providers (LIVE) ---
# STATUS: MOCKED — no authorized commercial integration is claimed.
# Adapters implement a provider-independent interface so real
# credentials can be dropped in later.
# GROCERY_PROVIDER_KEY=""