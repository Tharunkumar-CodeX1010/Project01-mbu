// ============================================================
// PROJECT TAC — YUMMYGO domain model
//
// STATUS: schema is authored + validated (`prisma validate`).
// Live PostgreSQL is a BLOCKED_EXTERNAL_DEPENDENCY in this
// workspace; runtime data ships as typed static seed modules.
//
// The schema is intentionally normalized around culinary
// entities so Recipes <-> Ingredients <-> Kitchen <-> History
// <-> Culinary Art <-> Products <-> Marketplace share one model.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum SkillLevel {
  NOVICE
  HOME_COOK
  ADVANCED
  PROFESSIONAL
}

enum EvidenceLevel {
  ESTABLISHED
  LIKELY
  DISPUTED
  UNKNOWN
}

enum ProviderStatus {
  MOCKED
  AUTHORIZED_INTEGRATION
  UNAVAILABLE
}

enum AvailabilityStatus {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  UNKNOWN
}

enum OptimizerObjective {
  LOWEST_COST
  FASTEST_DELIVERY
  BALANCED
}

enum DatasetStatus {
  DRAFT
  VALIDATED
  IN_TRAINING
  BENCHMARKED
  APPROVED
  REJECTED
  DEPRECATED
}

enum ModelStatus {
  CANDIDATE
  BENCHMARKED
  APPROVED
  DEPLOYED
  ROLLED_BACK
  REJECTED
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  EMBED_REFERENCE
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

// ---------- Discovery ----------

model Region {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameLocal String?
  blurb    String
  heroImage String?
  cuisines Cuisine[]
  dishes   Dish[]
}

model Cuisine {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  description String?
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  dishes   Dish[]
}

model Dish {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameLocal   String?
  altNames    String[]
  summary     String
  heroImage   String?
  videoUrl    String?
  tags        String[]
  rating      Float?
  ratingSource String?
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  cuisineId   String?
  cuisine     Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  recipes     Recipe[]
  foodHistory FoodHistory[]
  videos      Video[]
}

// ---------- Recipes ----------

model Recipe {
  id            String    @id @default(cuid())
  slug          String    @unique
  dishId        String
  dish          Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  title         String
  summary       String
  story         String?
  difficulty    DifficultyLevel @default(MEDIUM)
  servings      Int       @default(2)
  prepMinutes   Int       @default(0)
  cookMinutes   Int       @default(0)
  totalMinutes  Int       @default(0)
  image         String?
  notes         String?
  steps         RecipeStep[]
  ingredients   RecipeIngredient[]
  equipment     RecipeEquipment[]
  techniques    CulinaryTechnique[]
  createdAt     DateTime  @default(now())
}

model RecipeStep {
  id            String  @id @default(cuid())
  recipeId      String
  recipe        Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position      Int
  title         String
  technique     String?
  explanation   String
  tip           String?
  warning       String?
  timingMinutes Int?
  imageUrl      String?
  aiExplanation String?
}

model Ingredient {
  id       String             @id @default(cuid())
  slug     String             @unique
  name     String
  category String?
  aliases      IngredientAlias[]
  recipeUses   RecipeIngredient[]
  pantryUses   PantryItem[]
  productUses  ProductIngredient[]
  shoppingUses ShoppingListItem[]
}

model IngredientAlias {
  id           String     @id @default(cuid())
  alias        String
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, alias])
}

model RecipeIngredient {
  id           String       @id @default(cuid())
  recipeId     String
  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  quantity     Float        @default(1)
  unit         String       @default("")
  notes        String?
  optional     Boolean      @default(false)

  @@unique([recipeId, ingredientId])
}

model Equipment {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  category    String?
  recipes     RecipeEquipment[]
  kitchenUses KitchenEquipment[]
}

model RecipeEquipment {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  required    Boolean  @default(true)
}

model CulinaryTechnique {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String?
  description String
  recipes     Recipe[]
}

// ---------- Kitchen / User context ----------

model KitchenProfile {
  id           String              @id @default(cuid())
  browserId    String              @unique
  skill        SkillLevel          @default(HOME_COOK)
  householdSize Int                @default(2)
  preferences  String[]
  pantry       PantryItem[]
  equipment    KitchenEquipment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PantryItem {
  id                String         @id @default(cuid())
  kitchenProfileId  String
  kitchenProfile    KitchenProfile @relation(fields: [kitchenProfileId], references: [id], onDelete: Cascade)
  ingredientId      String?
  ingredient        Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  name              String
  quantity          Float?
  unit              String?
}

model KitchenEquipment {
  id               String         @id @default(cuid())
  kitchenProfileId String
  kitchenProfile   KitchenProfile @relation(fields: [kitchenProfileId], references: [id], onDelete: Cascade)
  equipmentId      String
  equipment        Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  notes            String?
}

// ---------- Food history ----------

model FoodHistory {
  id            String         @id @default(cuid())
  slug          String         @unique
  dishId        String?
  dish          Dish?          @relation(fields: [dishId], references: [id], onDelete: SetNull)
  title         String
  summary       String
  originSummary String?
  evidenceLevel EvidenceLevel  @default(ESTABLISHED)
  startYear     Int?
  endYear       Int?
  sources       String[]
  events        HistoryEvent[]
}

model HistoryEvent {
  id            String      @id @default(cuid())
  foodHistoryId String
  foodHistory   FoodHistory @relation(fields: [foodHistoryId], references: [id], onDelete: Cascade)
  year          Int?
  period        String?
  title         String
  description   String
  evidenceLevel EvidenceLevel @default(ESTABLISHED)
}

// ---------- Video / media ----------

model Video {
  id        String        @id @default(cuid())
  dishId    String?
  dish      Dish?         @relation(fields: [dishId], references: [id], onDelete: SetNull)
  provider  VideoProvider
  providerId String?
  title     String
  channel   String?
  durationSeconds Int?
  thumbUrl  String?
  embedSafe Boolean       @default(false)
  status    ProviderStatus @default(MOCKED)
}

// ---------- Marketplace ----------

model Product {
  id             String             @id @default(cuid())
  slug           String             @unique
  canonicalName  String
  brand          String?
  category       String?
  ingredients    ProductIngredient[]
  offers         ProviderProduct[]
  shoppingUses   ShoppingListItem[]
}

model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model Provider {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  status     ProviderStatus    @default(MOCKED)
  url        String?
  apiDocumentation String?
  createdAt  DateTime          @default(now())
  offers     ProviderProduct[]
}

model ProviderProduct {
  id           String      @id @default(cuid())
  providerId   String
  provider     Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalId   String?
  name         String
  normalizedName String?
  packQuantity Float       @default(1)
  packUnit     String      @default("")
  prices       Price[]
}

model Price {
  id                String              @id @default(cuid())
  providerProductId String
  providerProduct   ProviderProduct     @relation(fields: [providerProductId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String              @default("INR")
  availability      AvailabilityStatus  @default(IN_STOCK)
  deliveryFee       Float?
  minOrderAmount    Float?
  etaMinutes        Int?
  isMock            Boolean             @default(true)
  fetchedAt         DateTime            @default(now())
}

// ---------- Shopping ----------

model ShoppingList {
  id        String             @id @default(cuid())
  title     String
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredientId   String?
  ingredient     Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  quantity       Float        @default(1)
  unit           String       @default("")
  checked        Boolean      @default(false)
}

model CartSnapshot {
  id                 String             @id @default(cuid())
  objective          OptimizerObjective @default(LOWEST_COST)
  inputJson          Json
  resultJson         Json
  createdAt          DateTime           @default(now())
}

// ---------- AI assistant ----------

model AIConversation {
  id          String       @id @default(cuid())
  browserId   String?
  pageContext String?
  messages    AIMessage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolCallsJson  Json?
  createdAt      DateTime       @default(now())
}

// ---------- Knowledge / model governance ----------

model KnowledgeDocument {
  id             String       @id @default(cuid())
  slug           String       @unique
  domain         String
  title          String
  body           String
  contentType    String
  sourceUrl      String?
  sourceName     String?
  confidence     Float?
  evidenceLevel  EvidenceLevel @default(UNKNOWN)
  tags           String[]
  createdAt      DateTime     @default(now())
}

model Dataset {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  versions    DatasetVersion[]
  createdAt   DateTime          @default(now())
}

model DatasetVersion {
  id          String        @id @default(cuid())
  datasetId   String
  dataset     Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  version     String
  status      DatasetStatus @default(DRAFT)
  recordCount Int?
  sha256      String?
  path        String?
  createdAt   DateTime      @default(now())

  @@unique([datasetId, version])
}

model Model {
  id         String          @id @default(cuid())
  slug       String          @unique
  name       String
  family     String?
  description String?
  versions   ModelVersion[]
  createdAt  DateTime        @default(now())
}

model ModelVersion {
  id             String      @id @default(cuid())
  modelId        String
  model          Model       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  version        String
  status         ModelStatus @default(CANDIDATE)
  benchmarkJson  Json?
  evalReportJson Json?
  paramsHash     String?
  createdAt      DateTime    @default(now())
  deployedAt     DateTime?
  rolledBackAt   DateTime?

  @@unique([modelId, version])
}

// ---------- Daily content ----------

model DailyContent {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD
  version      Int      @default(1)
  manifestJson Json
  source       String   @default("validated-fallback") // generated | validated-fallback | manual
  createdAt    DateTime @default(now())
}